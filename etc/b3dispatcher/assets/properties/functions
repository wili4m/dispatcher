# Function utilizada para exibir uma barra formada por caracteres "="

function_include_bar () {

    i="0"

    while [ $i -lt 60 ]
    do
    echo -n "~"
    i=$[$i+1]
    done

}

function set_sleep_to_recollect() {

        action="set_sleep_to_recollect"
        messagelog="Executando function de coleta de reports na B3."
        logmein

    # Verifica se a variavel esta com valor. Se nao, seta valor default de 15 minutos:
    if [ -z "$waiting_collect_interval" ]; then

        action="Aviso"
        messagelog="O parametro waiting_collect_interval nao esta configurado corretamente. Vide arquivo de configuracao."
        logmein

        waiting_collect_interval="15"
        waiting_collect_interval_in_sec="900"

        action="Aviso"
        messagelog="Utilizando o valor padrao de 15 minutos."
        logmein

    else

        if [ -z $waiting_collect_interval_in_sec ]; then

            # Converte o tempo de espera em minutos setado na config para segundos:
            waiting_collect_interval_in_sec="$(expr $waiting_collect_interval \* 60)"

            action="Info"
            messagelog="Intervalo de coleta de report na B3: $waiting_collect_interval minuto(s)."
            logmein

        fi

    fi
}

function function_chk_processed_files () {

    action="function_chk_processed_files"
    messagelog="Executando funcao de checagem de erros em arquivos de report da B3."
    logmein

    # Confirma mais uma vez que o arquivo foi baixado:
    if [ -f "${sendfile_processed}" ]; then

        action="Info"
        messagelog="Recebido arquivo de retorno da B3: ${sendfile_processed}"
        logmein

        echo -e "\n${cyn}Validando erros...\n"

        action="Info"
        messagelog="Validando erros em ${sendfile_processed}"
        logmein

        # Whitelist:
        # Aqui eh verificado se o arquivo de report possui mensagem de erro alem daquelas que encontram-se em Whitelist.

        # Pega as mensagens de erro na Whitelist e as separa com um OU logico:
        b3_error_whitelist_with_logic_or="$(echo -e $b3_error_whitelist  | sed -e "s/,/\\\|/g")"

        # Valida se ha registros com 'Erro arquivo' que nao estejam na Whitelist:
        if [[ $(grep -w "$phrase_error_report" $sendfile_processed | grep -v "$b3_error_whitelist_with_logic_or") ]]; then

            # Se houver erro fora da whitelist, move o arquivo para o diretorio apropriado.
            # Tambem move o arquivo enviado que gerou erro no report:

            action="Alerta"
            messagelog="A B3 apontou erro(s) no conteudo do arquivo ${sendfile}. Sao erros nao presentes na Whitelist."
            logmein

            action="Alerta"
            messagelog="O arquivo ${sendfile} e o seu report ${check_out_report} serao movidos para ${sent_files_failure_report_dir}"
            logmein

            # Move o arquivo de report obtido na B3:
            mv -f ${sendfile_processed} ${sent_files_failure_report_dir}/

            case $? in
                0) action="Info";
                   messagelog="Arquivo ${check_out_report} movido para ${sent_files_failure_report_dir}" ;
                   logmein;;
                *) action="Erro" ;
                   messagelog="Erro ao mover arquivo $check_out_report para ${sent_files_failure_report_dir}" ;
                   logmein;;
            esac

            # Move o arquivo enviado para a B3 e que gerou erro no report:
            mv -f ${sent_files_waiting_b3_report}/${sendfile} ${sent_files_failure_report_dir}/

            case $? in
                0) action="Info";
                   messagelog="Arquivo ${sendfile} movido para ${sent_files_failure_report_dir}" ;
                   logmein;;
                *) action="Erro" ;
                   messagelog="Erro ao mover arquivo ${sendfile} para ${sent_files_failure_report_dir}" ;
                   logmein;;
            esac

        else

            # Se nao houver erro ou houver apenas erros presentes na Whitelist, move o arquivo para o diretorio apropriado. Tambem move o arquivo enviado para a B3:
            echo -e "\n${grn}A B3 nao reportou erro no conteudo do arquivo ${sendfile}.${nc}"
            echo -e "${grn}O arquivo ${sendfile} e o seu report ${check_out_report} serao movidos para ${sent_files_success_report_dir}.${nc}"

            # Aqui eh movido o arquivo de retorno da B3, porem a extensao do arquivo eh alterada para TXT:
            mv -f ${sendfile_processed} ${sent_files_success_report_dir}/

            case $? in
               0) action="Info";
                  messagelog="Arquivo ${check_out_report} movido para ${sent_files_success_report_dir}" ;
                  logmein;;
               *) action="Erro" ;
                  messagelog="Erro ao mover arquivo $check_out_report para ${sent_files_success_report_dir}" ;
                  logmein;;
            esac

            # Aqui eh movido o arquivo enviado e processado com sucesso pela B3:
            mv -f ${sent_files_waiting_b3_report}/${sendfile} ${sent_files_success_report_dir}/

            case $? in
              0) action="Info";
                 messagelog="Arquivo ${sendfile} movido para ${sent_files_success_report_dir}" ;
                 logmein;;
              *) action="Erro" ;
                 messagelog="Erro ao mover arquivo ${sendfile} para ${sent_files_success_report_dir}" ;
                 logmein;;
            esac

        fi 

    else

        # Tentei forcar esse erro, mas nao consegui. Se vc cair aqui, me conta pfv:

        action="Erro Critico"
        messagelog="O loop while encontrou o arquivo, mas o condicionamento nao. Investigar snippet009"
        logmein

        echo -e "\n${red}Erro critico. O loop while encontrou o arquivo, mas o condicionamento nao.${nc}...\n"
        echo -e "\n${red}Investigar linhas 54 e 108 do snippet009.${nc}...\n"

    fi

}

