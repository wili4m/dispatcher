# Function para calcular tempo de execucao da ferramenta:

function function_calculate_execution_time() {

    # Determina a hora final da execucao:
    finish_execution_hour=$(date +%H)

    # Determina a hora inicial da execucao:
    finish_execution_minute=$(date +%M)

    # Verifica se o minuto final de execucao eh menor do que o minuto inicial:
    if [ "$finish_execution_minute" -lt "$start_execution_minute" ]; then

        # Se sim, subtrai o valor 1 da hora final de execucao:
        finish_execution_hour=$(echo "$finish_execution_hour - 1" | bc)

        # Subtrai o valor minuto final de minuto inicial:
        finish_execution_minute_sub=$(echo "$start_execution_minute - $finish_execution_minute" | bc)

        # Determina o valor de minutos subtraindo o valor obtido da subtracao de minuto inicial e minuto final
        total_minutes=$(echo "60 - $finish_execution_minute_sub" | bc)

    # Caso minuto final e minuto inicial sejam iguais, apenas seta valor 0
    elif [ "$finish_execution_minute" -eq "$start_execution_minute" ]; then

        total_minutes="0"

    else

        # Caso minuto final seja maior do que minuto inicial, apenas subtrai minuto inicial de minuto final.
        total_minutes=$(echo "$finish_execution_minute - $start_execution_minute" | bc)

    fi

    # Verifica se a hora final de execucao eh menor do que a hora inicial:
    if [ "$finish_execution_hour" -lt "$start_execution_hour" ]; then

        # Subtrai o valor hora final de hora inicial:
        finish_execution_hour_sub=$(echo "$start_execution_hour - $finish_execution_hour" | bc)

        # Determina o valor de horas subtraindo o valor obtido da subtracao de hora inicial e hora final
        total_hours=$(echo "24 - $finish_execution_hour_sub" | bc)

    # Caso hora final e hora inicial sejam iguais, apenas seta valor 0
    elif [ "$finish_execution_hour" -eq "$start_execution_hour" ]; then

        total_hours=0

    else

        # Caso hora final seja maior do que hora inicial, apenas subtrai hora inicial de hora final.
        total_hours=$(echo "$finish_execution_hour - $start_execution_hour" | bc)

    fi

    # Loga hora e minuto do inicio da execucao:
    action="function_calculate_execution_time"
    messagelog="Inicio da Execucao: ${start_execution_hour}:${start_execution_minute}"
    logmein

    # Loga hora e minuto do fim da execucao:
    action="function_calculate_execution_time"
    messagelog="Fim da Execucao: ${finish_execution_hour}:${finish_execution_minute}"
    logmein

    # Loga tempo total de execucao:
    action="function_calculate_execution_time"
    messagelog="Tempo total de Execucao: $total_hours hora(s) e $total_minutes minuto(s)"
    logmein

}

# Essa function eh utilizada nos snippets para evitar que esses sejam executados de forma
# direta, ou seja, sem passar pela tool. Somente a tool pode executar os snippets, pois a
# execucao direta de snippets pode gerar comportamentos inexperados.

function block_snippet_exec() {

    action="block_snippet_exec"
    messagelog="Checando permissao para execucao de Snippets."
    logmein

    # Verifica o path do binario requisitor do snippet.
    # Se for diferente da ferramenta, apresenta erro.

    # Somente 3 utilitarios podem executar snippets:

    # b3dispatcher
    if [ $0 != "${tool}" ]; then

        # b3cli
        if [ $0 != "${cli}" ]; then

            # b3cron
            if [ $0 != "${tool_cron}" ]; then

                # Qualquer coisa diferente dos utilitarios, eh bloqueado.
                action="Erro"
                messagelog="Execucao de Snippet negada."
                logmein

                action="Warn"
                messagelog="Somente ${tool}, ${cli} e ${tool_cron} podem executar Snippets."
                logmein

                echo -e "\n${ylw}Execucao de snippet negada. Vide log.${nc}\n"
                exit 1

            else

                # Se entrar aqui, ta tudo certo.
                action="Info"
                messagelog="Execucao de Snippet autorizada."
                logmein

            fi

        else

            # Se entrar aqui, ta tudo certo.
            action="Info"
            messagelog="Execucao de Snippet autorizada."
            logmein

        fi

    else

        # Se entrar aqui, ta tudo certo.
        action="Info"
        messagelog="Execucao de Snippet autorizada."
        logmein

    fi

}

# Function que cria variaveis em tempo de execucao. Essas vars usam o valor de variaveis predispostas no arquivo de configuracao.
# Porem determina qual variavel utilizara com base no nome do arquivo/Cia.

function func_refeed_var_credentials() {

    # Verifica da empresa presente no arquivo de configuracoes e remove a virgula
    for empresaID in $(echo $empresas | sed -e "s/,/ /g") ; do

        # Printa arquivos encontrado no diretorio de envio para a B3, verifica se o nome do arquivo
        # comeca com o ID da empresa.
        if [[ $(echo $fileFound | grep ^$empresaID) ]]; then
    
            # Declara o ID da empresa para contactenar com o valor de modal e criar a variavel de conexao:
            declare empresaID=$empresaID

            # Loga Informacao:
            action="Info"
            messagelog="Determinando credenciais para Cia ${empresaID}."
            logmein

            # Atribui o valor das variaveis modal e empresaid para determinar o valor das vars
            # de acesso. Essas vars ja possuem valor na configuracao da tool. Aqui so eh determinada
            # qual dessas vars sera usada baseado na Cia presente no nome do arquivo:
            host=${modal}_target_empresa_${empresaID}
            user=${modal}_userid_empresa_${empresaID}
            pass=${modal}_rsakey_empresa_${empresaID}
    
            # Verifica o valor atribuido as variaveis criadas acima:
            for checkVar in host user pass; do

                # Declara checkVarValue para pegar o valor atribuido as vars criadas em tempo de execucao:
                declare checkVarValue=$checkVar

                # Verifica o valor das variaveis. Devem comecar com o modal que corresponde ao ambiente:
                if [ $(echo ${!checkVarValue} | grep -v ^${modal}) ]; then

                    # Se entrou aqui eh pq a variavel esta com valor invalido ou nulo. Pode ocorre pq:
                    # O modal esta errado ou nao existe. Checar variavel modal no arquivo de configuracao
                    # A empresa esta errada na configuracao ou no nome do arquivo ou nao existe.
                    # Nome das variaveis de credenciais nao estao de acordo com o padrao da tool.
                    action="Erro"
                    messagelog="Variavel ${!checkVarValue}} eh invalida."
                    logmein

                    action="Erro"
                    messagelog="Verificar configuracao (modal, empresas e credenciais)."
                    logmein

                else

                    # Se entrou aqui, ta tudo certo com as variaveis criadas em tempo de execucao.
                    action="Info"
                    messagelog="Determinanda variavel ${!checkVarValue}}."
                    logmein

                fi; done

        fi ; done 

}

