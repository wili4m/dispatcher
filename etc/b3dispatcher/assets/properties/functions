# Esta function eh utilizada para logar mensagens no log do sistema. As variaveis actionlog
# e messagelog sao alimentadas em tempo de execucao pelos snippets, que por sua vez chamam
# esta function. Os logs ficam no /var/log e podem ser syslog (debian) ou messages (centos).

function logmein() {

    # Comando utilizado para logar mensagens no log do sistema:
    logger -t [${tool_name}] "[${actionlog}] ${messagelog}"

}

function get_lock() {

actionlog="get_lock"
messagelog="Verificando se existe lock file."
logmein

# Verifica se o lock file existe:
if [ -e "${lockfile}" ]; then

    # Carrega o PID contindo no lockfile
    b3pid=$(cat ${lockfile})

    # Verifica se o PID do lockfile existe:
    findPID=$(ps aux | grep $b3pid | grep -v grep | awk '{print$2}')

    # Se nao houver PID no lockfile, grava o PID da execucao atual no lockfile
    if [ -z $b3pid ]; then

        echo $$ > ${lockfile}

        actionlog="get_lock"
        messagelog="Nao ha execucoes no momento. Atualizado o lock file."
        logmein

    # Se houver PID no lockfile, mas nao existir, tb grava o PID da execucao atual no lockfile:
    elif [ -z $findPID ] ; then

        echo $$ > ${lockfile}

        actionlog="get_lock"
        messagelog="Nao ha execucoes no momento. Atualizado o lock file."
        logmein

    # Se o PID do lockfile for diferente do atual PID e esse PID existir, considera-se que ha processo em execucao:
    elif [ $b3pid -ne "$$" ] && [ ! -z $findPID ]; then

        echo -e "\n${ylw}>>> Processo abortado${nc}: Ja existe um processo $b3pid em execucao. Aguarde o seu encerramento.\n"

        actionlog="get_lock"
        messagelog="Encontrado PID $b3pid em execucao. Nova execucao abortada."
        logmein

        exit 1

    # Caso nenhum dos cenarios acima ocorra, entra no else. Pouco provavel que ocorra:
    else

        actionlog="get_lock"
        messagelog="Erro ao identificar processos em andamento."
        logmein

        exit 1

    fi

else

    # Caso o arquivo de lock nao exista, o cria com o PID:
    echo $$ > ${lockfile}

fi

}

function del_lock() {

actionlog="del_lock"
messagelog="Removendo lock file ${lockfile}."
logmein

    # Verifica se ha lock file:
    if [ -f "${lockfile}" ]; then

        # Remove o arquivo de lock:
        rm -f ${lockfile}

        # Logs:
        case $? in
        0) actionlog="del_lock" ;
           messagelog="Lock file ${lockfile} removido." ;
           logmein ;;
        *) actionlog="del_lock" ;
           messagelog="Falha na remocao do lock file ${lockfile}." ;
           logmein ;;
        esac

    fi

}

